            "emoji": "📉",
            "color": "#dc2626"
          }
        }
      ]
    },
    {
      "type": "folder",
      "name": "Admin consoles",
      "items": [
        {
          "name": "Microsoft 365 admin",
          "url": "https://admin.microsoft.com/",
          "icon": {
            "type": "emoji",
            "emoji": "🛠️",
