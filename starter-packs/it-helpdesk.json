{
  "app": "tootsy",
  "kind": "apps",
  "version": 2,
  "title": "IT helpdesk starter",
  "description": "Service status pages, admin consoles and security checks, plus prompts to triage tickets, reply to users and write knowledge-base articles.",
  "exportedAt": "2026-10-16T00:00:00.000Z",
  "apps": [
    {
      "type": "folder",
      "name": "Service status",
