{
  "app": "tootsy",
  "kind": "apps",
  "version": 2,
  "title": "Research starter",
  "description": "Paper search, data sources and citation tools, plus prompts to summarise papers, compare sources and cite pages.",
  "exportedAt": "2026-10-17T00:00:00.000Z",
  "apps": [
    {
      "type": "folder",
      "name": "Research pack",
      "items": [
        {
          "name": "Google Scholar",
          "url": "https://scholar.google.com/",
          "icon": {
            "type": "emoji",
            "emoji": "🎓",
            "color": "#2563eb"
          }
        },
        {
          "name": "Semantic Scholar",
          "url": "https://www.semanticscholar.org/",
          "icon": {
            "type": "emoji",
            "emoji": "🧠",
            "color": "#1e40af"
          }
        },
        {
          "name": "PubMed",
          "url": "https://pubmed.ncbi.nlm.nih.gov/",
          "icon": {
            "type": "emoji",
            "emoji": "🧬",
            "color": "#0e7490"
          }
        },
        {
          "name": "arXiv",
          "url": "https://arxiv.org/",
          "icon": {
            "type": "emoji",
            "emoji": "📄",
            "color": "#b91c1c"
          }
        },
        {
          "name": "JSTOR",
          "url": "https://www.jstor.org/",
          "icon": {
            "type": "emoji",
            "emoji": "📚",
            "color": "#9f1239"
          }
        },
        {
          "name": "Connected Papers",
          "url": "https://www.connectedpapers.com/",
          "icon": {
            "type": "emoji",
            "emoji": "🕸️",
            "color": "#7c3aed"
          }
        },
        {
          "name": "Our World in Data",
          "url": "https://ourworldindata.org/",
          "icon": {
            "type": "emoji",
            "emoji": "🌍",
            "color": "#0f766e"
          }
        },
        {
          "name": "World Bank Data",
          "url": "https://data.worldbank.org/",
          "icon": {
            "type": "emoji",
            "emoji": "🏦",
            "color": "#1d4ed8"
          }
        },
        {
          "name": "Dataset Search",
          "url": "https://datasetsearch.research.google.com/",
          "icon": {
            "type": "emoji",
            "emoji": "🗃️",
            "color": "#ea580c"
          }
        },
        {
          "name": "Statista",
          "url": "https://www.statista.com/",
          "icon": {
            "type": "emoji",
            "emoji": "📊",
            "color": "#0369a1"
          }
        },
        {
          "name": "Zotero",
          "url": "https://www.zotero.org/",
          "icon": {
            "type": "emoji",
            "emoji": "🔖",
            "color": "#dc2626"
          }
        },
        {
          "name": "Overleaf",
          "url": "https://www.overleaf.com/",
          "icon": {
            "type": "emoji",
            "emoji": "📝",
            "color": "#15803d"
          }
        },
        {
          "type": "prompt",
          "name": "Summarise this paper",
          "prompt": "Summarise this paper: research question, method, data or sample, key findings (with the numbers), limitations, and how it relates to {{ask: Your research topic?}}. Quote the line that supports each finding.",
          "send": true,
          "hands": false,
          "icon": {
            "type": "emoji",
            "emoji": "📄",
            "color": "#2563eb"
          }
        },
        {
          "type": "prompt",
          "name": "Extract the methods",
          "prompt": "From this page, list the study design, sample size, variables, instruments and statistical tests as a table. Write \"not reported\" for anything the paper doesn't state.",
          "send": true,
          "hands": false,
          "icon": {
            "type": "emoji",
            "emoji": "🧪",
            "color": "#0e7490"
          }
        },
        {
          "type": "prompt",
          "name": "Compare my sources",
          "prompt": "Search my files for {{ask: Topic or question?}} and compare what each source says: where they agree, where they contradict each other, and what none of them covers. Name the file for every point.",
          "send": true,
          "hands": false,
          "icon": {
            "type": "emoji",
            "emoji": "⚖️",
            "color": "#7c3aed"
          }
        },
        {
          "type": "prompt",
          "name": "Cite this page",
          "prompt": "Create an APA 7 citation for this page ({{page}}), and the same reference as BibTeX. If the author or date is missing, say so instead of guessing.",
          "send": true,
          "hands": false,
          "icon": {
            "type": "emoji",
            "emoji": "🔖",
            "color": "#dc2626"
          }
        },
        {
          "type": "prompt",
          "name": "Explain simply",
          "prompt": "Explain this for a smart non-specialist in under 150 words, then list 3 key terms with one-line definitions:\n\n{{selection}}",
          "send": true,
          "hands": false,
          "icon": {
            "type": "emoji",
            "emoji": "💡",
            "color": "#ca8a04"
          }
        },
        {
          "type": "prompt",
          "name": "Find related work",
          "prompt": "Search the web for studies from the last 3 years that address the same question as this page. List 5 with title, year, venue and link, and one sentence on how each relates.",
          "send": true,
          "hands": false,
          "icon": {
            "type": "emoji",
            "emoji": "🔭",
            "color": "#0f766e"
          }
        },
        {
          "type": "prompt",
          "name": "Literature notes",
          "prompt": "Turn this page into literature-review notes in Markdown: full citation, a 5-sentence summary, key quotes with their section, and 3 questions I should ask about it.",
          "send": true,
          "hands": false,
          "icon": {
            "type": "emoji",
            "emoji": "🗒️",
            "color": "#334155"
          }
        }
      ]
    }
  ]
}
